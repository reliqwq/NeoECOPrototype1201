{
  "$schema": "../schema.json",
  "includes": [
    "../interface.json"
  ],
  "background": {
    "$comment": "textureHeight must equal the real height of the PNG: AE2 divides the v coordinates by it, and its default is 256. A sheet that is not 256 tall gets stretched by the ratio and wraps past its own bottom edge.",
    "texture": "guis/neoecoprototype/powered_interface.png",
    "textureHeight": 261,
    "srcRect": [
      0,
      0,
      176,
      261
    ]
  },
  "slots": {
    "CONFIG": {
      "left": 8,
      "top": 54,
      "grid": "BREAK_AFTER_9COLS",
      "$comment": "The texture draws four groove rows, at 54, 72, 108 and 126: a config row, a storage row, a gap, then the same pair again. The grid alone would stack our rows at 18px, so PoweredInterfaceScreen.moveSecondRow adds 36 to slots 10-18 of both sections. Each config row then has a blank band of its own for its nine amount buttons, which is the only reason the panel is 261 tall instead of 225."
    },
    "STORAGE": {
      "left": 8,
      "top": 72,
      "grid": "BREAK_AFTER_9COLS"
    },
    "PLAYER_INVENTORY": {
